              "type": "integer"
            },
            "indexed": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "selected": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "skipped": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "stale": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            },
            "undated": {
              "format": "uint",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "excluded",
            "indexed",
            "selected",
            "skipped",
            "stale",
            "undated"
          ],
          "type": "object"
