{
  "$defs": {
    "plugin_protocol::ActivateParams": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string"
        }
      },
      "required": [
        "event"
      ],
      "title": "ActivateParams",
      "type": "object"
    },
    "plugin_protocol::ExecuteCommandParams": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "context": true
      },
      "required": [
        "command",
        "context"
      ],
      "title": "ExecuteCommandParams",
      "type": "object"
    },
    "plugin_protocol::IndexBlocksParams": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "fileKeys": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "maxBytes": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "snapshotId": {
          "type": "string"
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "fileKeys",
        "snapshotId",
        "version"
      ],
      "title": "IndexBlocksParams",
      "type": "object"
    },
    "plugin_protocol::IndexBlocksResult": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "definitions": {
        "IndexConflict": {
          "properties": {
            "fileKey": {
              "type": "string"
            },
            "reason": {
              "type": "string"
            }
          },
          "required": [
            "fileKey",
            "reason"
          ],
          "type": "object"
        },
        "IndexPriorityFactors": {
          "properties": {
            "agent": {
              "format": "double",
              "type": "number"
            },
            "annotation": {
              "format": "double",
              "type": "number"
            },
            "attention": {
              "format": "double",
              "type": "number"
            },
            "freshness": {
              "format": "double",
              "type": "number"
            },
            "origin": {
              "format": "double",
              "type": "number"
            },
            "structural": {
              "format": "double",
              "type": "number"
            },
            "verified": {
              "format": "double",
              "type": "number"
            }
          },
          "required": [
            "agent",
            "annotation",
            "attention",
            "freshness",
            "origin",
            "structural",
            "verified"
          ],
          "type": "object"
        },
        "IndexUnit": {
          "properties": {
            "agentBy": {
              "type": [
                "string",
                "null"
              ]
            },
            "blockKey": {
              "type": "string"
            },
            "breadcrumb": {
              "type": "string"
            },
            "contentHash": {
              "type": "string"
            },
            "fileKey": {
              "type": "string"
            },
            "isAnnotation": {
              "type": "boolean"
            },
            "level": {
              "type": "string"
            },
            "lineEnd": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "lineStart": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            },
            "priority": {
              "format": "double",
              "type": "number"
            },
            "priorityFactors": {
              "$ref": "#/definitions/IndexPriorityFactors"
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "blockKey",
            "breadcrumb",
            "contentHash",
            "fileKey",
            "isAnnotation",
            "level",
            "lineEnd",
            "lineStart",
            "priority",
            "priorityFactors",
            "text"
          ],
          "type": "object"
        }
      },
      "properties": {
        "conflicts": {
          "items": {
            "$ref": "#/definitions/IndexConflict"
          },
          "type": "array"
        },
        "nextCursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "snapshotId": {
          "type": "string"
        },
        "units": {
          "items": {
            "$ref": "#/definitions/IndexUnit"
          },
          "type": "array"
        }
      },
      "required": [
        "conflicts",
        "snapshotId",
        "units"
      ],
      "title": "IndexBlocksResult",
      "type": "object"
    },
    "plugin_protocol::IndexSnapshotParams": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "definitions": {
        "IndexRange": {
          "additionalProperties": false,
          "properties": {
            "dateKind": {
              "type": "string"
            },
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            }
          },
          "required": [
            "dateKind",
            "from",
            "to"
          ],
          "type": "object"
        }
      },
      "properties": {
        "cursor": {
          "type": [
            "string",
            "null"
          ]
        },
        "pageSize": {
          "format": "uint",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "range": {
          "anyOf": [
            {
              "$ref": "#/definitions/IndexRange"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "version"
      ],
      "title": "IndexSnapshotParams",
      "type": "object"
    },
    "plugin_protocol::IndexSnapshotResult": {
