        "IndexFile": {
          "properties": {
            "attentionMinutes": {
              "format": "double",
              "type": "number"
            },
            "conceptType": {
              "type": [
                "string",
                "null"
              ]
            },
            "confidentiality": {
              "type": "string"
            },
            "contentHash": {
              "type": "string"
            },
            "dateInferred": {
              "type": "boolean"
            },
            "docDate": {
              "type": [
                "string",
                "null"
              ]
            },
            "fileKey": {
              "type": "string"
            },
            "filePriority": {
              "format": "double",
              "type": "number"
            },
            "humanVerified": {
              "type": "boolean"
            },
            "indexOrigin": {
              "type": "string"
            },
            "links": {
