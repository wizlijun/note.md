      {#if updater.state === 'checking'}
        <h2 id="updater-title">{t('updateDialog.checking')}</h2>
        <p class="meta">{t('updateDialog.currentVersion', { version: updater.currentVersion ?? '' })}</p>
        <div class="progress-wrap">
