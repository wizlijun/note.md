  "contract": {
    "topic_discovery": "notemd ebook --list-topics --json",
    "import": "notemd ebook \"/absolute/path/book.epub\" --topic <topic-id> --json",
    "ocr": "notemd ebook \"/absolute/path/book.pdf\" --topic <topic-id> --ocr --json",
    "explicit_vault": "notemd ebook --vault \"/absolute/vault\" --list-topics --json",
    "formats": [
      "epub",
      "pdf",
      "docx"
    ],
    "minimum_host": "6.915.3",
    "optional_flags": [
      "--root",
      "--ocr-provider wechat|baidu"
    ],
    "result_fields": [
      "dest",
      "dest_rel",
      "topic_id",
      "ocr",
      "provider",
      "log"
    ],
    "behavior": [
      "CLI and UI share the conversion/OCR/import/index pipeline.",
      "Optional manifest path argument is canonicalized by the host relative to the caller cwd.",
      "Topic IDs come from the real catalog, not display labels.",
      "List activation and discovery do not seed templates, recover journals or rebuild indexes.",
      "Explicit Vault is command-local and cannot be replaced by asynchronous host discovery.",
      "Empty/conflicting options and unsupported OCR combinations fail before conversion or OCR.",
      "Imports recover interrupted topic transactions before modifying the inventory; another root cannot replay the configured library journal.",
      "Thirty-second liveness and real stage/page progress preserve the host idle timeout without changing operation deadlines.",
      "OCR is explicit opt-in; pages are sent to the configured WeChat/Baidu service. Ordinary import never silently switches to OCR."
    ]
  },
