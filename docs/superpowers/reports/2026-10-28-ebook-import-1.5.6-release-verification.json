    "github_tag_verified": true
  },
  "contract": {
    "default_agent": "notemd ebook \"/absolute/book.epub\" --topic <topic-id> --ai-read --json",
    "explicit_agent": "notemd ebook \"/absolute/book.epub\" --topic <topic-id> --ai-read --agent notemd.codex-agent --json",
    "ocr_and_ai": "notemd ebook \"/absolute/book.pdf\" --topic <topic-id> --ocr --ai-read --json",
    "minimum_host": "6.915.3",
    "behavior": [
      "Default Agent comes from host.agent.providers; an explicit installed plugin ID pins this run and does not change preferences.",
      "AI reading is opt-in and may send book content to the selected model service.",
      "AI requires the current host Vault; another explicit Vault is rejected before import. Ordinary imports retain independent --vault support.",
      "Successful imports wait for the actual summary; Agent errors preserve imported:true and dest with structured exit code 4.",
      "Import failure does not start AI. A Vault switch during conversion becomes an AI-only failure.",
      "Shared SDK routes host replies while synchronous callbacks wait, preserving serial callbacks and closing pending requests on EOF/deactivation.",
      "No model version URL switch: the existing Baidu API is documented as Unlimited OCR 2.",
      "Baidu local upload rejects more than 50,000,000 bytes or 500 pages, and invalid PDFs before OAuth. No automatic URL upload, split, or provider switch."
    ]
  },
