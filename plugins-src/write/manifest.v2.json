{
  "manifest_version": 2,
  "id": "notemd.sumi",
  "name": "Sumi Write",
  "version": "0.1.16",
  "kind": "native",
  "binary": {
    "aarch64-apple-darwin": "bin/notemd-sumi",
    "x86_64-unknown-linux-gnu": "bin/notemd-sumi"
  },
  "engines": {
    "notemd": ">=6.1111.1"
  },
  "description": "Sumi Write is a quiet page for native writing, with offline collaboration and seamless continuation.",
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "create",
        "label": "Sumi Write",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Sumi Write",
        "width": 960,
        "height": 720,
        "resizable": false,
        "open_command": "open"
      }
    ],
    "file_views": [
      {
        "id": "writing",
        "entry": "index.html",
        "surface": "native-editor",
        "icon": "book",
        "open_command": "read-writing",
        "priority": 100,
        "selectors": [
          {
            "file_extensions": [
              "md"
            ],
            "frontmatter": {
              "type": [
                "Writing Page"
              ]
            }
          }
        ]
      }
    ],
    "tray": [
      {
        "window": "main",
        "section": "capture"
      }
    ]
  },
  "capabilities": [
    "editor.native",
    "editor.write",
    "editor.open",
    "vault.read",
    "vault.write",
    "editor.kit"
  ],
  "i18n": {
    "zh": {
      "name": "玄霜写作",
      "description": "玄霜写作，一页纸，安静地写。原生编辑，离线也能续写，多设备自动同步。",
      "menus": {
        "open": "玄霜写作",
        "read-writing": "玄霜写作"
      },
      "windows": {
        "main": "玄霜写作"
      }
    },
    "en": {
      "name": "Sumi Write",
      "description": "Sumi Write is a quiet page for native writing, with offline collaboration and seamless continuation.",
      "menus": {
        "open": "Sumi Write",
        "read-writing": "Sumi Write"
      },
      "windows": {
        "main": "Sumi Write"
      }
    },
    "ja": {
      "name": "Sumi Write",
      "description": "Sumi Write は、静かに書くためのタイプライターアプリです。ネイティブ編集で、オフラインでも書き続けられ、端末間で自動同期します。",
      "menus": {
        "open": "Sumi Write",
        "read-writing": "Sumi Write"
      },
      "windows": {
        "main": "Sumi Write"
      }
    }
  }
}
