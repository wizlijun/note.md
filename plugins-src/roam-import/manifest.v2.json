{
  "manifest_version": 2,
  "id": "notemd.roam-import",
  "name": "Roam Research Sync",
  "version": "1.2.6",
  "kind": "native",
  "binary": {
    "aarch64-apple-darwin": "bin/notemd-roam-import",
    "x86_64-apple-darwin": "bin/notemd-roam-import"
  },
  "engines": {
    "notemd": ">=6.828.3"
  },
  "description": "Keep using Roam Research while synchronizing its pages and daily notes into the vault as .note.md files for agents to search and compute across.",
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open",
      "onCli:roam-day",
      "onCli:roam-sync"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "file",
        "submenu": "import-export",
        "label": "Sync Roam Research…",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Roam Research Sync",
        "width": 680,
        "height": 620,
        "min_width": 520,
        "min_height": 420,
        "open_command": "open"
      }
    ],
    "cli": [
      {
        "subcommand": "roam-day",
        "command": "sync-day",
        "summary": "Sync one day's Roam daily note into the vault",
        "args": [],
        "flags": [
          { "long": "--date", "type": "string", "help": "yyyy-MM-dd, today or yesterday (default: yesterday)" },
          { "long": "--graph", "type": "string", "help": "Roam graph name (default: the CLI's own default)" }
        ],
        "requires_tab_context": false
      },
      {
        "subcommand": "roam-sync",
        "command": "sync-changed",
        "summary": "Sync every Roam page changed since the last sync",
        "args": [],
        "flags": [
          { "long": "--since", "type": "string", "help": "Override the stored watermark (yyyy-MM-dd)" },
          { "long": "--graph", "type": "string", "help": "Roam graph name (default: the CLI's own default)" },
          { "long": "--dry-run", "type": "boolean", "help": "List what would be synced without writing" }
        ],
        "requires_tab_context": false
      }
    ]
  },
  "capabilities": [
    "dialog",
    "vault.read",
    "vault.write",
    "fs.read:dialog",
    "clipboard.write",
    "toast",
    "ui"
  ],
  "request_timeout_seconds": 120,
  "i18n": {
    "zh": {
      "name": "Roam Research 同步",
      "description": "无需离开 Roam Research；将其中的页面和每日笔记同步为 Vault 内的 `.note.md` 文件，汇集数据供 Agent 统一检索和计算。",
      "menus": {
        "open": "同步 Roam Research…"
      },
      "windows": {
        "main": "Roam Research 同步"
      }
    },
    "ja": {
      "name": "Roam Research 同期",
      "description": "Roam Research を使い続けながら、ページとデイリーノートを Vault の `.note.md` ファイルへ同期し、Agent が横断的に検索・処理できるようにします。",
      "menus": {
        "open": "Roam Research を同期…"
      },
      "windows": {
        "main": "Roam Research 同期"
      }
    },
    "de": {
      "name": "Roam-Research-Synchronisierung",
      "description": "Roam Research weiter nutzen und Seiten sowie tägliche Notizen als `.note.md`-Dateien ins Vault synchronisieren, damit Agents die gesammelten Daten durchsuchen und verarbeiten können.",
      "menus": {
        "open": "Roam Research synchronisieren…"
      },
      "windows": {
        "main": "Roam-Research-Synchronisierung"
      }
    }
  }
}
