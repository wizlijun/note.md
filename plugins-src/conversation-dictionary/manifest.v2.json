{
  "manifest_version": 2,
  "id": "notemd.conversation-dictionary",
  "name": "Conversation Transcript Corrections",
  "version": "0.1.13",
  "kind": "native",
  "engines": {
    "notemd": ">=6.916.1"
  },
  "description": "Review formal names, aliases, and ASR mistakes from conversations you participate in, then normalize confirmed corrections by context.",
  "binary": {
    "aarch64-apple-darwin": "bin/notemd-conversation-dictionary",
    "x86_64-apple-darwin": "bin/notemd-conversation-dictionary"
  },
  "ui": "ui/",
  "activation": {
    "events": [
      "onCommand:open",
      "onCli:conversation-dictionary"
    ]
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "ai",
        "label": "Conversation Transcript Corrections…",
        "command": "open"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "index.html",
        "title": "Conversation Transcript Corrections",
        "width": 1060,
        "height": 760,
        "min_width": 720,
        "min_height": 520,
        "open_command": "open",
        "singleton": true
      }
    ],
    "cli": [
      {
        "subcommand": "conversation-dictionary",
        "command": "conversation-dictionary",
        "summary": "Inspect, resolve or propose conversation transcription dictionary data",
        "args": [
          {
            "name": "action",
            "type": "string",
            "required": true,
            "help": "status, list, resolve, propose, pending, check, dataset-check or dataset-import"
          }
        ],
        "flags": [
          { "long": "--input", "type": "string", "help": "Vault-relative JSON/YAML request or dataset file" },
          { "long": "--domain", "type": "string", "help": "Exact domain ID" },
          { "long": "--id", "type": "string", "help": "Exact candidate ID" }
        ],
        "requires_tab_context": false
      }
    ]
  },
  "capabilities": [
    "ui",
    "toast",
    "vault.read",
    "vault.write",
    "editor.open"
  ],
  "request_timeout_seconds": 120,
  "i18n": {
    "zh": {
      "name": "沟通转写勘误",
      "description": "整理你参与的会议、通话和语音消息中的正式名、别称与 ASR 误识别，经确认后按场景统一输出正式名。",
      "menus": { "open": "沟通转写勘误…" },
      "windows": { "main": "沟通转写勘误" }
    },
    "ja": {
      "name": "会話文字起こし訂正",
      "description": "参加した会議、通話、音声メッセージの正式名、別名、ASR誤認識を確認し、文脈ごとに正式名へ統一します。",
      "menus": { "open": "会話文字起こし訂正…" },
      "windows": { "main": "会話文字起こし訂正" }
    },
    "de": {
      "name": "Gesprächstranskript-Korrekturen",
      "description": "Prüft offizielle Namen, Aliase und ASR-Fehler in eigenen Gesprächen und vereinheitlicht bestätigte Korrekturen je Kontext.",
      "menus": { "open": "Gesprächstranskript-Korrekturen…" },
      "windows": { "main": "Gesprächstranskript-Korrekturen" }
    }
  }
}
