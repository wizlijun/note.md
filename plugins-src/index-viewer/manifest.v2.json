{
  "manifest_version": 2,
  "id": "notemd.index-viewer",
  "name": "Index Viewer",
  "version": "1.0.2",
  "kind": "native",
  "engines": {
    "notemd": ">=6.910.1"
  },
  "description": "Browse Markdown file indexes as cover galleries, tables, grouped lists and swimlane boards. Organize entries with headings and single-line list attributes, and navigate tags like wiki links.",
  "ui": "ui/",
  "activation": {
    "events": []
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "reading",
        "label": "View File Index",
        "command": "view-index"
      }
    ],
    "file_views": [
      {
        "id": "index",
        "entry": "index.html",
        "icon": "generic",
        "open_command": "view-index",
        "priority": 100,
        "selectors": [
          {
            "file_name_patterns": [
              "*.index.md"
            ]
          }
        ]
      }
    ]
  },
  "capabilities": [
    "vault.read",
    "editor.open"
  ],
  "i18n": {
    "zh": {
      "name": "索引查看器",
      "description": "以封面画廊、多列表格、分组列表或泳道看板查看 Markdown 文件索引；使用标题分类和单行列表属性，标签与双链均可打开知识页面。",
      "menus": {
        "view-index": "打开索引查看器"
      }
    }
  }
}
