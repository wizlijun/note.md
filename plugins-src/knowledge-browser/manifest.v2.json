{
  "manifest_version": 2,
  "id": "notemd.knowledge-browser",
  "name": "Knowledge Browser",
  "version": "3.2.0",
  "kind": "native",
  "engines": {
    "notemd": ">=6.916.1"
  },
  "description": "Browse extracted knowledge as an interactive graph, relation groups, timelines and source evidence without changing the source dataset.",
  "ui": "ui/",
  "activation": {
    "events": []
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "reading",
        "label": "Open Knowledge Browser…",
        "command": "view-knowledge",
        "prompt": {
          "kind": "open-dialog",
          "filters": [
            {
              "name": "JSON",
              "extensions": ["json"]
            }
          ]
        }
      }
    ],
    "file_views": [
      {
        "id": "knowledge",
        "entry": "viewer.html",
        "icon": "generic",
        "open_command": "view-knowledge",
        "priority": 100,
        "selectors": [
          {
            "file_extensions": ["json"]
          }
        ]
      }
    ]
  },
  "capabilities": [
    "vault.read",
    "editor.open",
    "clipboard.write"
  ],
  "i18n": {
    "zh": {
      "name": "提取知识浏览器",
      "description": "以交互图谱、关系组、时间线和原文证据只读浏览提取知识。",
      "menus": {
        "view-knowledge": "打开提取知识浏览器…"
      }
    }
  }
}
