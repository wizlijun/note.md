{
  "manifest_version": 2,
  "id": "notemd.knowledge-browser",
  "name": "Knowledge Browser",
  "version": "1.2.0",
  "kind": "native",
  "engines": {
    "notemd": ">=6.916.1"
  },
  "description": "Browse extracted knowledge, relations, timelines and source evidence without changing the source dataset.",
  "ui": "ui/",
  "activation": {
    "events": []
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "reading",
        "label": "Open Knowledge Browser…",
        "command": "view-knowledge",
        "prompt": {
          "kind": "open-dialog",
          "filters": [
            {
              "name": "JSON",
              "extensions": ["json"]
            }
          ]
        }
      }
    ],
    "file_views": [
      {
        "id": "knowledge",
        "entry": "viewer.html",
        "icon": "generic",
        "open_command": "view-knowledge",
        "priority": 100,
        "selectors": [
          {
            "file_extensions": ["json"]
          }
        ]
      }
    ]
  },
  "capabilities": [
    "vault.read",
    "editor.open",
    "clipboard.write"
  ],
  "i18n": {
    "zh": {
      "name": "提取知识浏览器",
      "description": "只读浏览提取的知识对象、多方关系、时间线与原文证据。",
      "menus": {
        "view-knowledge": "打开提取知识浏览器…"
      }
    }
  }
}
