{
  "manifest_version": 2,
  "id": "notemd.knowledge-browser",
  "name": "Knowledge Browser",
  "version": "1.1.0",
  "kind": "native",
  "engines": {
    "notemd": ">=6.915.3"
  },
  "description": "Browse extracted knowledge, relations, timelines and source evidence without changing the source dataset.",
  "ui": "ui/",
  "activation": {
    "events": []
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "reading",
        "label": "Open Knowledge Browser…",
        "command": "open-browser"
      }
    ],
    "windows": [
      {
        "id": "main",
        "entry": "browser.html",
        "title": "Knowledge Browser",
        "width": 1180,
        "height": 800,
        "min_width": 640,
        "min_height": 480,
        "singleton": true,
        "open_command": "open-browser"
      }
    ],
    "file_views": [
      {
        "id": "knowledge",
        "entry": "viewer.html",
        "icon": "generic",
        "open_command": "view-knowledge",
        "priority": 100,
        "selectors": [
          {
            "file_extensions": ["json"]
          }
        ]
      }
    ]
  },
  "capabilities": [
    "vault.read",
    "editor.open",
    "dialog",
    "fs.read:dialog",
    "clipboard.write",
    "settings"
  ],
  "i18n": {
    "zh": {
      "name": "提取知识浏览器",
      "description": "只读浏览提取的知识对象、多方关系、时间线与原文证据。",
      "menus": {
        "open-browser": "打开提取知识浏览器…",
        "view-knowledge": "查看提取知识"
      }
    }
  }
}
