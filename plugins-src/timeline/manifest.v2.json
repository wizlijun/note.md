{
  "manifest_version": 2,
  "id": "notemd.timeline",
  "name": "Timeline",
  "version": "1.1.0",
  "kind": "native",
  "engines": {
    "notemd": ">=6.909.4"
  },
  "description": "View daily timelines with event importance, anomaly badges, evidence details, and configurable activity categories.",
  "ui": "ui/",
  "activation": {
    "events": []
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "reflect",
        "label": "View Timeline",
        "command": "view-timeline"
      }
    ],
    "file_views": [
      {
        "id": "timeline",
        "entry": "index.html",
        "icon": "clock",
        "open_command": "view-timeline",
        "priority": 100,
        "selectors": [
          {
            "file_extensions": [
              "md",
              "markdown",
              "mdown",
              "mkd"
            ],
            "frontmatter": {
              "type": [
                "timeline"
              ]
            }
          }
        ]
      }
    ]
  },
  "capabilities": [
    "settings",
    "vault.read",
    "editor.open"
  ],
  "i18n": {
    "zh": {
      "name": "时间轴",
      "description": "以竖向日程查看每日时间线，显示事件重要程度、反常标识及判断证据，并可自定义活动分类。",
      "menus": {
        "view-timeline": "查看时间轴"
      }
    }
  }
}
