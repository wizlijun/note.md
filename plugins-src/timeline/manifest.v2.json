{
  "manifest_version": 2,
  "id": "notemd.timeline",
  "name": "Timeline",
  "version": "1.2.0",
  "kind": "native",
  "engines": {
    "notemd": ">=6.1021.1"
  },
  "description": "View and edit daily timeline activities, descriptions, times, and event importance, with preserved source links and configurable categories.",
  "ui": "ui/",
  "activation": {
    "events": []
  },
  "contributes": {
    "menus": [
      {
        "location": "plugins",
        "submenu": "reflect",
        "label": "View Timeline",
        "command": "view-timeline"
      }
    ],
    "file_views": [
      {
        "id": "timeline",
        "entry": "index.html",
        "icon": "clock",
        "open_command": "view-timeline",
        "priority": 100,
        "selectors": [
          {
            "file_extensions": [
              "md",
              "markdown",
              "mdown",
              "mkd"
            ],
            "frontmatter": {
              "type": [
                "timeline"
              ]
            }
          }
        ]
      }
    ]
  },
  "capabilities": [
    "settings",
    "vault.read",
    "editor.open",
    "editor.write"
  ],
  "i18n": {
    "zh": {
      "name": "时间轴",
      "description": "查看并编辑每日时间线的活动名称、描述、起止时间和重要程度，保留来源链接并支持自定义分类。",
      "menus": {
        "view-timeline": "查看时间轴"
      }
    }
  }
}
