# Local Sumi addon package; fixed source commit b75c450fe8ee0249d20d8727abe59c2b818e0c16.
pkgname=fcitx5-sumi-candidates
pkgver=5.1.23.r3.gb75c450f
pkgrel=1
pkgdesc='Application-owned Fcitx candidate presentation for the native Sumi editor'
arch=('x86_64')
url='https://github.com/wizlijun/fcitx5'
license=('LGPL-2.1-or-later')
depends=('fcitx5>=5.1.23' 'fcitx5<5.2' 'gcc-libs' 'glibc')
makedepends=('gcc' 'pkgconf')
options=('!debug' '!lto')
source=('fcitx5-sumi-source.tar.gz')
sha256sums=('cf4ad1867750dbe283c047d64e867e270f1e607624b2437df2a6f93d3669d4bd')

build() {
    cd "$srcdir/fcitx5-sumi/src/modules/sumicandidates"
    g++ -std=c++20 -shared -fPIC $CXXFLAGS \
        -Wall -Wextra -Werror sumicandidates.cpp -o libsumicandidates.so \
        $(pkg-config --cflags --libs Fcitx5Core) \
        -I/usr/include/Fcitx5/Module/fcitx-module/dbus $LDFLAGS
    sed -e 's/@FCITX_ADDON_TYPE@/SharedLibrary/g' \
        -e 's/@PROJECT_VERSION@/5.1.23/g' \
        sumicandidates.conf.in > sumicandidates.conf
}

package() {
    cd "$srcdir/fcitx5-sumi"
    install -Dm755 src/modules/sumicandidates/libsumicandidates.so \
        "$pkgdir/usr/lib/fcitx5/libsumicandidates.so"
    install -Dm644 src/modules/sumicandidates/sumicandidates.conf \
        "$pkgdir/usr/share/fcitx5/addon/sumicandidates.conf"
    install -Dm644 LICENSES/LGPL-2.1-or-later.txt \
        "$pkgdir/usr/share/licenses/$pkgname/LGPL-2.1-or-later.txt"
}
