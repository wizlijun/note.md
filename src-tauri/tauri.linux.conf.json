{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "targets": [
      "deb"
    ],
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "license": "Apache-2.0",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "git",
          "xdg-utils"
        ],
        "desktopTemplate": "linux/notemd.desktop.hbs",
        "files": {
          "/usr/share/doc/note.md/copyright": "../LICENSE"
        }
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd"
        ],
        "name": "Markdown",
        "description": "Markdown document",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "txt",
          "text"
        ],
        "name": "Plain Text",
        "description": "Plain text file",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": [
          "canvas"
        ],
        "name": "JSON Canvas",
        "description": "JSON Canvas document",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ]
  },
  "app": {
    "enableGTKAppId": true
  }
}
